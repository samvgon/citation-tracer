# Copy to .env and fill in. .env is gitignored; never put keys in code.

# LLM endpoint (any OpenAI-compatible server). Overrides config/default.yaml.
# Local llama.cpp:  LLM_BASE_URL=http://localhost:8080/v1  LLM_API_KEY=sk-local
# OpenAI API:       LLM_BASE_URL=https://api.openai.com/v1 LLM_MODEL=<model name>
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

